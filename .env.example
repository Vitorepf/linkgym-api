# Copiado automaticamente por `make setup`. Não commitar o `.env`.

PORT=8080
AUTH_PEPPER=linkgym-dev-pepper

# Host: 5436. Dentro do Docker Compose a API usa o hostname `postgres` na 5432.
DATABASE_URL=postgres://linkgym:linkgym@localhost:5436/linkgym?sslmode=disable

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=linkgym
S3_ACCESS_KEY=linkgym
S3_SECRET_KEY=linkgymsecret
S3_USE_SSL=false
